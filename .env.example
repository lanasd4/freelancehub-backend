NODE_ENV=development
PORT=3100

# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/freelancehub?schema=public"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/freelancehub_test?schema=public"
# docker-compose only
DB_PASSWORD=

# Redis (cache + queues)
REDIS_URL=redis://localhost:6380/0
TEST_REDIS_URL=redis://localhost:6380/1

# JWT: two different random strings, 32+ chars
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Platform admin (created automatically on first start)
ADMIN_EMAIL=admin@freelancehub.local
ADMIN_PASSWORD=

CORS_ORIGINS=http://localhost:5173
THROTTLE_LIMIT=100

# Email: leave SMTP_HOST empty in development (emails are written to the log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FreelanceHub <no-reply@freelancehub.local>"

# Midnight job time zone
CRON_TZ=Asia/Damascus
